---
import AboutHeroImage from '../assets/blog-placeholder-about.jpg';
import Page from '../layouts/Page/Page.astro';
import FallbackImage from "../assets/blog-placeholder-1.jpg";
import { ClientRouter } from 'astro:transitions';
import {PROJECTS} from "../consts.ts";
import { Projects } from "../components/Projects/projects.tsx";

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = FallbackImage } = Astro.props;

---

<Page
	title="Projects"
	description="Lorem ipsum dolor sit amet"
	heroImage={AboutHeroImage}
	url={Astro.url}
	generator={Astro.generator}
	site={Astro.site}
>
	<ClientRouter slot="head" />

	<p>Take a look at some of my projects.</p>

	<Projects projects={PROJECTS} variant="large" />
</Page>
