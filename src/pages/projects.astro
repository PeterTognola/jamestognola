---
import Page from '../layouts/Page/Page.astro';
import { ClientRouter } from 'astro:transitions';
import { PROJECTS } from "../consts.ts";
import { Projects as ProjectsComponent } from "../components/Projects/projects.tsx";
---

<Page
	title="Projects"
	description={"A complete list of projects by James Tognola."}
	url={Astro.url}
	generator={Astro.generator}
	site={Astro.site}
>
	<ClientRouter slot="head" />

	<p>Take a look at some of my projects: idea stage, in-progress, and complete.</p>

	<hr />

	<ProjectsComponent projects={PROJECTS} variant="large" />
</Page>
