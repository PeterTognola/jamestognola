---
import { SITE_DESCRIPTION } from '../consts';
import Page from "../layouts/Page/Page.astro";
import { ClientRouter } from 'astro:transitions';
import { Projects } from "../components/Projects/projects.tsx";
import {PROJECTS} from "../consts.ts";
---

<Page
	title="Hello, and Welcome!"
	description={SITE_DESCRIPTION}
	url={Astro.url}
	generator={Astro.generator}
	site={Astro.site}
>
	<ClientRouter slot="head" />
	<p>
		Welcome to my collection of projects and random wittering of my thoughts, code, and experiences.
	</p>
	<p>
		I am an experienced full-stack, working predominantly in leadership, and centred around shipping software at pace and efficiently. In my spare time I am, <em>at present</em>, focusing on: somewhat machine learning with <strong>TensorFlow + Typescript</strong>, weirdly fun frontend projects in <strong>React + Typescript</strong>, and programs that resemble APIs in <strong>C#</strong>.
	</p>
	<p>You can "checkout" and view some of my most recent work:</p>

	{<Projects projects={PROJECTS} />}

	<p>
		I am a big believer of everything open source, proudly a Linux (Ubuntu) user, and push the open source mentality across businesses, colleagues and teams.
	</p>
	<p>
		If you like the layout and design of this website and want to copy it, feel free to clone it <a href="https://github.com/PeterTognola/jamestognola/">from my GitHub</a>.
	</p>
</Page>
